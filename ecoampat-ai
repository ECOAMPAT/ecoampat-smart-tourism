function ecoAI(input) {

  input = input.toLowerCase();

  if (input.includes("budget") && input.includes("3")) {
    return "🧭 Rekomendasi: Pianemo + Homestay (hemat trip)";
  }

  if (input.includes("5 juta")) {
    return "🧭 Rekomendasi: Wayag + Pianemo 3 hari full trip";
  }

  if (input.includes("snorkeling")) {
    return "🐠 Best spot: Misool & Pianemo";
  }

  if (input.includes("3 hari")) {
    return "📍 Itinerary: Hari 1 Pianemo, Hari 2 Wayag, Hari 3 Misool";
  }

  return "🤖 AI: sedang memproses rencana perjalanan terbaik...";
}
function runAI() {
  let input = document.getElementById("input").value;
  let result = ecoAI(input);

  document.getElementById("result").innerText = result;
}

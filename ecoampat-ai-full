async function askAI() {
  const input = document.getElementById("input").value;

  document.getElementById("result").innerText = "Thinking...";

  const res = await fetch("http://localhost:3000/api/ask", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ message: input })
  });

  const data = await res.json();

  document.getElementById("result").innerText = data.reply;
}
const express = require("express");
const cors = require("cors");
const axios = require("axios");
require("dotenv").config();

const app = express();
app.use(cors());
app.use(express.json());

app.post("/api/ask", async (req, res) => {
  try {
    const message = req.body.message;

    const response = await axios.post(
      "https://api.openai.com/v1/chat/completions",
      {
        model: "gpt-4o-mini",
        messages: [
          {
            role: "system",
            content: "Kamu adalah AI Travel Assistant EcoAmpat untuk Raja Ampat. Berikan itinerary, budget, transport, dan rekomendasi wisata."
          },
          {
            role: "user",
            content: message
          }
        ],
        temperature: 0.7
      },
      {
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${process.env.OPENAI_API_KEY}`
        }
      }
    );

    res.json({
      reply: response.data.choices[0].message.content
    });

  } catch (err) {
    res.json({ reply: "Error AI server" });
  }
});

app.listen(process.env.PORT || 3000, () => {
  console.log("EcoAmpat backend running");
});
